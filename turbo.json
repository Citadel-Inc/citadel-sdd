{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "outputs": []
    },
    "lint:citadel-parity": {
      "env": ["CITADEL_PARITY_ROOT"]
    },
    "test": {
      "outputs": []
    }
  }
}
