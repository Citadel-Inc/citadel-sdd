{
  "name": "@rethunk/citadel-sdd",
  "version": "0.7.0",
  "description": "MCP stdio server wrapping the Spec-Driven Development lifecycle for agent workflows.",
  "type": "module",
  "private": false,
  "packageManager": "bun@1.4.0",
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "HUMANS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "citadel-sdd": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && mkdir -p dist/profile && cp src/profile/*.yaml dist/profile/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/ tests/",
    "test:coverage": "bun test src/ tests/ --coverage",
    "prepublishOnly": "bun run ci",
    "lint:citadel-parity": "bun scripts/lint-citadel-parity.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "keywords": [
    "mcp",
    "spec-driven-development",
    "sdd",
    "model-context-protocol",
    "stdio",
    "llm",
    "agent-workflow",
    "bastion",
    "citadel"
  ],
  "author": "Rethunk-AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citadel-Inc/citadel-sdd.git"
  },
  "bugs": {
    "url": "https://github.com/Citadel-Inc/citadel-sdd/issues"
  },
  "homepage": "https://github.com/Citadel-Inc/citadel-sdd#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.6",
    "body-parser": "^2.4.0",
    "qs": "^6.17.1"
  }
}
