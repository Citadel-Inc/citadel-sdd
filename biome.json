{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": {
        "preset": "none"
      },
      "style": {
        "noTernary": "off",
        "noContinue": "off",
        "noMagicNumbers": "off",
        "useExportsLast": "off",
        "useFilenamingConvention": {
          "level": "info",
          "options": {
            "filenameCases": ["camelCase", "kebab-case", "snake_case", "export"]
          }
        },
        "useNamingConvention": {
          "level": "info",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "typeProperty" },
                "match": "P[0-2]|[a-z][a-zA-Z0-9]*|[a-z][a-z0-9]*(?:_[a-z0-9]+)*"
              },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "match": "P[0-2]|[a-z][a-zA-Z0-9]*|[a-z][a-z0-9]*(?:_[a-z0-9]+)*"
              },
              {
                "selector": { "kind": "typeParameter" },
                "match": "[A-Z][a-zA-Z0-9]*"
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUnresolvedImports": "off",
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": {
          "level": "error",
          "options": { "extensionMappings": { "ts": "js", "tsx": "js" } }
        }
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": { "entropyThreshold": 50 }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "files": {
    "includes": ["src/**/*", "tests/**/*", "*.json", "*.md", "!.mcp.json"]
  },
  "overrides": [
    {
      "includes": ["src/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": {
              "level": "info",
              "options": {
                "strictCase": false,
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "Q[0-9]+|[A-Z][A-Z0-9_]*|[a-z][a-zA-Z0-9]*|[a-z][a-z0-9]*(?:_[a-z0-9]+)*"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
