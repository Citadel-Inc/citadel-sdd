{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": {
        "preset": "none"
      },
      "style": {
        "noTernary": "off",
        "noContinue": "off",
        "noMagicNumbers": "off",
        "useExportsLast": "off",
        "useFilenamingConvention": {
          "level": "info",
          "options": {
            "filenameCases": ["camelCase", "kebab-case", "snake_case", "export"]
          }
        },
        "useNamingConvention": {
          "level": "info",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "snake_case"]
              },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "snake_case", "PascalCase"]
              },
              {
                "selector": { "kind": "typeParameter" },
                "match": "[A-Z][a-zA-Z0-9]*"
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUnresolvedImports": "off",
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": {
          "level": "error",
          "options": { "forceJsExtensions": true }
        }
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": { "entropyThreshold": 50 }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "files": {
    "includes": ["src/**/*", "tests/**/*", "*.json", "*.md", "!.mcp.json"]
  },
  "overrides": [
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    }
  ]
}
